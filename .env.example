# Скопируй в .env (или сгенерит install.sh). Обязателен только REDIS_URL.
REDIS_URL=redis://127.0.0.1:6379
MODEL=qwen2.5:7b
# TIER задаёт очередь воркера llm:<tier> (Routing v2): strong|fast|embed.
# Если не задан — выводится из MODEL по карте (см. src/config.js), иначе fast.
TIER=fast
OLLAMA_URL=http://127.0.0.1:11434
CONCURRENCY=2
# WORKER_ID=  # по умолчанию hostname
# QUEUE=  # DEPRECATED: явный override одиночной очереди (старая llm-tasks). По умолчанию llm:<tier>.
