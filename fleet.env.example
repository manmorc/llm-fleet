# Пример локального секрет-файла ноды. РЕАЛЬНЫЙ файл — ~/.agent-bus/fleet.env (ВНЕ репо, не коммитить).
# ecosystem.config.js читает его лениво; секреты остаются локально.
REDIS_URL=redis://:<PASSWORD>@artyom-prestige-14evo-b13m.tail241f5d.ts.net:6379
FLEET_NODE_ID=desktop-tt4i69c
FLEET_MODEL=gemma4:latest
OLLAMA_URL=http://127.0.0.1:11434
# AGENT_SUPERVISOR=deny   # режим надзора агента (deny=read-only обкатка; ask=y/N в терминале; bus=Claude-in-the-loop)

# --- ENV САМОЙ OLLAMA (ставятся на уровне ОС/пользователя, НЕ через этот файл) ---
# OLLAMA_HOST=0.0.0.0        # слушать tailnet, чтобы флот слал инференс на ноду (+ firewall-правило на 100.64.0.0/10)
# OLLAMA_KEEP_ALIVE=60s      # ВАЖНО: модель выгружается из VRAM через 60с простоя (дефолт 5 мин держал GPU занятой).
#                            # Модель грузится ПО ВЫЗОВУ (~11с холодная), в активном чате остаётся тёплой.
#                            # Windows: setx OLLAMA_KEEP_ALIVE 60s + перезапуск ollama.
